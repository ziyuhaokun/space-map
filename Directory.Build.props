<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Turn on the analyzer set that ships with the SDK. Without it "0 warnings" only
      means the rules were off, not that the code is clean.
    -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Project Metadata -->
    <Authors>ziyuhaokun</Authors>
    <Company>Space.Map</Company>
    <Product>Space.Map</Product>
    <Copyright>Copyright © 2026 ziyuhaokun</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
