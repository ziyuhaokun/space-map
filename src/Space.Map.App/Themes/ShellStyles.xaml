<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

        <SolidColorBrush x:Key="ShellPrimaryBrush" Color="#FF2F7DFF" />
        <SolidColorBrush x:Key="ShellPrimaryHoverBrush" Color="#FF3A86FF" />
        <SolidColorBrush x:Key="ShellGreenBrush" Color="#FF39D98A" />
        <SolidColorBrush x:Key="ShellPurpleBrush" Color="#FFB77CFF" />
        <SolidColorBrush x:Key="ShellYellowBrush" Color="#FFFFCC45" />
        <SolidColorBrush x:Key="ShellWarningBrush" Color="#FFFFA94D" />
        <SolidColorBrush x:Key="ShellIconTileBrush" Color="#203A5C88" />

        <Style x:Key="TitleBarIconPathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="TitleBarIconFillStyle" TargetType="Path">
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="TitleBarActionButtonStyle"
               BasedOn="{StaticResource {x:Type ui:Button}}"
               TargetType="{x:Type ui:Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}" />
            <Setter Property="PressedForeground" Value="{Binding ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}" />
            <Setter Property="MouseOverBackground" Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}" />
            <Setter Property="MouseOverBorderBrush" Value="Transparent" />
            <Setter Property="PressedBackground" Value="{Binding ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}" />
            <Setter Property="PressedBorderBrush" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style BasedOn="{StaticResource {x:Type ui:TitleBarButton}}"
               TargetType="{x:Type ui:TitleBarButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
        </Style>

        <Style x:Key="ShellPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="PrimaryCommandButtonStyle"
               BasedOn="{StaticResource {x:Type ui:Button}}"
               TargetType="{x:Type ui:Button}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SecondaryCommandButtonStyle"
               BasedOn="{StaticResource {x:Type ui:Button}}"
               TargetType="{x:Type ui:Button}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ToolIconButtonStyle"
               BasedOn="{StaticResource {x:Type ui:Button}}"
               TargetType="{x:Type ui:Button}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>

        <Style x:Key="ViewModeIconStyle" TargetType="{x:Type ui:SymbolIcon}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="17" />
        </Style>

        <Style x:Key="CompactStatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="CompactStatValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="PieLegendItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="12,10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#332F7DFF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#662F7DFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#223A5C88" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#443A5C88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PieLegendListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4,0,0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PieLegendItemStyle}" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="StatusValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="BreadcrumbButtonStyle"
               BasedOn="{StaticResource {x:Type ui:Button}}"
               TargetType="{x:Type ui:Button}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="DetailActionButtonStyle"
               BasedOn="{StaticResource {x:Type ui:Button}}"
               TargetType="{x:Type ui:Button}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!--
          Theme toggle glyphs (16×16):
          - Dark theme  → sun  (switch to light)
          - Light theme → moon (switch to dark)

          Both are drawn on a 16×16 grid with a 1.5 stroke so they read at the
          title bar's actual size, not just when scaled up.

          Sun: core circle r=2.75 centred at 8,8; eight rays of equal length
          (r=5.0 → r=7.0) on the cardinals and diagonals. The previous glyph used
          hand-picked ray endpoints that left the diagonals visibly longer and
          heavier than the cardinals.

          Moon: two arcs of r=6.2 (outer) and r=7.4 (inner) meeting at the tips.
          A near-identical inner radius is what makes it a crescent; the previous
          outline read as a circle with a bite taken out of it.
        -->
        <ControlTemplate x:Key="ThemeIconTemplate" TargetType="ContentControl">
            <Grid Width="16"
                  Height="16"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
                <!-- Sun (shown while dark) -->
                <Canvas Width="16"
                        Height="16">
                    <Canvas.Style>
                        <Style TargetType="Canvas">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Style>
                    <!-- Core -->
                    <Ellipse Width="5.5"
                             Height="5.5"
                             Canvas.Left="5.25"
                             Canvas.Top="5.25"
                             Fill="Transparent"
                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                             StrokeThickness="1.5" />
                    <!-- Eight rays, identical length on every axis -->
                    <Path Style="{StaticResource TitleBarIconPathStyle}"
                          Data="M8,3 L8,1
                                M8,13 L8,15
                                M3,8 L1,8
                                M13,8 L15,8
                                M4.464,4.464 L3.05,3.05
                                M11.536,4.464 L12.95,3.05
                                M11.536,11.536 L12.95,12.95
                                M4.464,11.536 L3.05,12.95" />
                </Canvas>

                <!-- Moon (shown while light): filled crescent, 16×16 -->
                <Path>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                    <Path.Fill>
                        <Binding Path="Foreground"
                                 RelativeSource="{RelativeSource AncestorType=Button}" />
                    </Path.Fill>
                    <Path.Data>
                        <PathGeometry Figures="M10.36,2.35 A6.2,6.2 0 1 0 10.36,13.65 A7.4,7.4 0 0 1 10.36,2.35 Z" />
                    </Path.Data>
                </Path>
            </Grid>
        </ControlTemplate>
</ResourceDictionary>
