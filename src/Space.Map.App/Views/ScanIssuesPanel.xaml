<UserControl x:Class="Space.Map.App.Views.ScanIssuesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander Header="{Binding Scan.IssuesHeader}"
              IsExpanded="{Binding Scan.IsIssuesPanelExpanded, Mode=TwoWay}"
              Visibility="{Binding Scan.HasIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ListBox MaxHeight="120"
                 ItemsSource="{Binding Scan.Issues}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding KindLabel}" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Path}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding Path}" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Opacity="0.85"
                                   Text="{Binding Message}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Expander>
</UserControl>
