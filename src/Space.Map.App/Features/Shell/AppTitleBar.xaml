<UserControl x:Class="Space.Map.App.Views.AppTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:TitleBar Height="48"
                 Padding="16,0,0,0"
                 ShowClose="True"
                 ShowMaximize="True"
                 ShowMinimize="True">
        <ui:TitleBar.Header>
            <StackPanel Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Width="32"
                        Height="32"
                        CornerRadius="7"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True">
                    <Image Source="pack://application:,,,/Assets/space.map-logo.png"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="Space.Map" />
            </StackPanel>
        </ui:TitleBar.Header>
        <ui:TitleBar.TrailingContent>
            <StackPanel Margin="0"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <ui:Button Command="{Binding ToggleLanguageCommand}"
                           Style="{StaticResource TitleBarActionButtonStyle}"
                           ToolTipService.ToolTip="{DynamicResource TitleBar_ToggleLanguage}">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding LanguageButtonLabel}" />
                </ui:Button>
                <ui:Button Command="{Binding ToggleThemeCommand}"
                           Style="{StaticResource TitleBarActionButtonStyle}"
                           ToolTipService.ToolTip="{Binding ThemeToggleToolTip}">
                    <ContentControl Template="{StaticResource ThemeIconTemplate}" />
                </ui:Button>
            </StackPanel>
        </ui:TitleBar.TrailingContent>
    </ui:TitleBar>
</UserControl>
