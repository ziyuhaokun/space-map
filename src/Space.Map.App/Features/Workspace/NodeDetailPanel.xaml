<UserControl x:Class="Space.Map.App.Views.NodeDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Border Padding="6"
            Style="{StaticResource ShellPanelStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="96"
                        Height="96"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <ui:SymbolIcon HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="54"
                                   Foreground="#FF6E90FF"
                                   Symbol="{Binding Navigation.DetailIconSymbol}" />
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding Navigation.SelectedNodeName}" />
                        <!-- Only meaningful while something is selected. -->
                        <Border Margin="12,4,0,0"
                                Padding="8,3"
                                VerticalAlignment="Top"
                                Background="#203A84D8"
                                CornerRadius="4"
                                Visibility="{Binding Navigation.HasDetailSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="12"
                                       Foreground="#FF66A6FF"
                                       Text="{DynamicResource Detail_CurrentSelected}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding Navigation.DetailNode.FullPath}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <ui:Button Command="{Binding Navigation.OpenInExplorerCommand}"
                                   Style="{StaticResource DetailActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0"
                                               Symbol="FolderOpen24" />
                                <TextBlock Text="{DynamicResource Detail_OpenLocation}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="8,0,0,0"
                                   Command="{Binding Navigation.CopyPathCommand}"
                                   Style="{StaticResource DetailActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0"
                                               Symbol="Copy24" />
                                <TextBlock Text="{DynamicResource Detail_CopyPath}" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Column="1"
                         Columns="4"
                         Rows="1">
                <Border Margin="10,0,0,0"
                        Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Foreground="#FF66A6FF"
                                           Symbol="DataPie24" />
                            <TextBlock Margin="8,0,0,0"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Text="{DynamicResource Detail_DirectSize}" />
                        </StackPanel>
                        <TextBlock Foreground="#FF66A6FF"
                                   Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding Navigation.DetailNode.Size}" />
                    </StackPanel>
                </Border>
                <Border Margin="10,0,0,0"
                        Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Foreground="{StaticResource ShellGreenBrush}"
                                           Symbol="ChartMultiple24" />
                            <TextBlock Margin="8,0,0,0"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Text="{DynamicResource Grid_Percent}" />
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource ShellGreenBrush}"
                                   Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding Navigation.DetailNode.PercentOfRoot}" />
                    </StackPanel>
                </Border>
                <Border Margin="10,0,0,0"
                        Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Foreground="{StaticResource ShellPurpleBrush}"
                                           Symbol="Document24" />
                            <TextBlock Margin="8,0,0,0"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Text="{DynamicResource Grid_Files}" />
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource ShellPurpleBrush}"
                                   Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding Navigation.DetailNode.FileCount}" />
                    </StackPanel>
                </Border>
                <Border Margin="10,0,0,0"
                        Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Foreground="{StaticResource ShellYellowBrush}"
                                           Symbol="Folder24" />
                            <TextBlock Margin="8,0,0,0"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Text="{DynamicResource Grid_Directories}" />
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource ShellYellowBrush}"
                                   Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding Navigation.DetailNode.DirectoryCount}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
