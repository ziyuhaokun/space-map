<UserControl x:Class="Space.Map.App.Views.ScanToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Left"
                    Orientation="Horizontal">
            <ui:Button Command="{Binding Scan.BrowseCommand}"
                       Style="{StaticResource ToolIconButtonStyle}"
                       ToolTipService.ToolTip="{DynamicResource Toolbar_Browse}">
                <ui:SymbolIcon Symbol="Folder24" />
            </ui:Button>

            <ui:Button Margin="6,0,0,0"
                       Command="{Binding Scan.SelectSystemDriveCommand}"
                       Style="{StaticResource ToolIconButtonStyle}"
                       ToolTipService.ToolTip="{DynamicResource Toolbar_SystemDrive}">
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding Scan.SystemDriveLabel}" />
            </ui:Button>

            <ui:Button Margin="6,0,0,0"
                       Command="{Binding Scan.SelectUserProfileCommand}"
                       Style="{StaticResource ToolIconButtonStyle}"
                       ToolTipService.ToolTip="{DynamicResource Toolbar_UserProfile}">
                <ui:SymbolIcon Symbol="Person24" />
            </ui:Button>

            <ui:Button Margin="6,0,0,0"
                       Command="{Binding DriveHome.ShowDriveHomeCommand}"
                       Style="{StaticResource ToolIconButtonStyle}"
                       ToolTipService.ToolTip="{DynamicResource Toolbar_DriveList}">
                <ui:SymbolIcon Symbol="HardDrive24" />
            </ui:Button>

            <ui:Button Margin="6,0,0,0"
                       Command="{Binding Scan.StartScanCommand}"
                       Style="{StaticResource ToolIconButtonStyle}"
                       ToolTipService.ToolTip="{DynamicResource Toolbar_StartScan}">
                <ui:SymbolIcon Foreground="{StaticResource ShellPrimaryBrush}"
                               Symbol="Play24" />
            </ui:Button>

            <ui:Button Margin="6,0,0,0"
                       Command="{Binding Scan.CancelScanCommand}"
                       Style="{StaticResource ToolIconButtonStyle}"
                       ToolTipService.ToolTip="{DynamicResource Toolbar_StopScan}">
                <ui:SymbolIcon Symbol="Stop24" />
            </ui:Button>

            <ui:Button Margin="12,0,0,0"
                       Command="{Binding Navigation.NavigateUpCommand}"
                       Style="{StaticResource ToolIconButtonStyle}"
                       ToolTipService.ToolTip="{DynamicResource Toolbar_NavigateUp}">
                <ui:SymbolIcon Symbol="ArrowUp24" />
            </ui:Button>
        </StackPanel>

        <StackPanel HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button Command="{Binding ShowTreemapViewCommand}"
                       Style="{StaticResource ToolIconButtonStyle}"
                       ToolTipService.ToolTip="{DynamicResource Toolbar_TreemapView}">
                <ui:SymbolIcon Symbol="Grid24">
                    <ui:SymbolIcon.Style>
                        <Style BasedOn="{StaticResource ViewModeIconStyle}"
                               TargetType="{x:Type ui:SymbolIcon}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTreemapView}"
                                             Value="True">
                                    <Setter Property="Foreground"
                                            Value="#FF64A4FF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
            </ui:Button>
            <ui:Button Margin="6,0,0,0"
                       Command="{Binding ShowListViewCommand}"
                       Style="{StaticResource ToolIconButtonStyle}"
                       ToolTipService.ToolTip="{DynamicResource Toolbar_ListView}">
                <ui:SymbolIcon Symbol="List24">
                    <ui:SymbolIcon.Style>
                        <Style BasedOn="{StaticResource ViewModeIconStyle}"
                               TargetType="{x:Type ui:SymbolIcon}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListView}"
                                             Value="True">
                                    <Setter Property="Foreground"
                                            Value="#FF64A4FF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
            </ui:Button>
            <ui:Button Margin="6,0,0,0"
                       Command="{Binding ShowStatisticsViewCommand}"
                       Style="{StaticResource ToolIconButtonStyle}"
                       ToolTipService.ToolTip="{DynamicResource Toolbar_StatisticsView}">
                <ui:SymbolIcon Symbol="DataPie24">
                    <ui:SymbolIcon.Style>
                        <Style BasedOn="{StaticResource ViewModeIconStyle}"
                               TargetType="{x:Type ui:SymbolIcon}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatisticsView}"
                                             Value="True">
                                    <Setter Property="Foreground"
                                            Value="#FF64A4FF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
            </ui:Button>
        </StackPanel>
    </Grid>
</UserControl>
