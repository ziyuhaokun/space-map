<UserControl x:Class="Space.Map.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Space.Map.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Columns="4"
                     Rows="1">
            <Border Margin="0,0,8,0"
                    Padding="12,10"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Style="{StaticResource CompactStatLabelStyle}"
                               Text="{DynamicResource Stats_TotalSize}" />
                    <TextBlock Foreground="#FF66A6FF"
                               Style="{StaticResource CompactStatValueStyle}"
                               Text="{Binding Scan.TotalSize}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0"
                    Padding="12,10"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Style="{StaticResource CompactStatLabelStyle}"
                               Text="{DynamicResource Stats_Files}" />
                    <TextBlock Foreground="{StaticResource ShellPurpleBrush}"
                               Style="{StaticResource CompactStatValueStyle}"
                               Text="{Binding Scan.TotalFiles}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0"
                    Padding="12,10"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Style="{StaticResource CompactStatLabelStyle}"
                               Text="{DynamicResource Stats_Directories}" />
                    <TextBlock Foreground="{StaticResource ShellYellowBrush}"
                               Style="{StaticResource CompactStatValueStyle}"
                               Text="{Binding Scan.TotalDirectories}" />
                </StackPanel>
            </Border>
            <Border Padding="12,10"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Style="{StaticResource CompactStatLabelStyle}"
                               Text="{DynamicResource Stats_Status}" />
                    <TextBlock FontSize="16"
                               Foreground="{StaticResource ShellGreenBrush}"
                               Style="{StaticResource CompactStatValueStyle}"
                               Text="{Binding Scan.ResultStatus}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="1"
              Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"
                               MinHeight="160" />
                <RowDefinition Height="*"
                               MinHeight="160" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Padding="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <controls:PieChartCanvas ItemsSource="{Binding Navigation.ChartTopItems}"
                                             SelectedItem="{Binding Navigation.SelectedNode, Mode=TwoWay}"
                                             TotalSizeBytes="{Binding Navigation.CurrentTreemapNode.SizeBytes, TargetNullValue=0}" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0">
                    <TextBlock Margin="4,0,0,8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{DynamicResource Stats_TopDistribution}" />
                    <ListBox ItemsSource="{Binding Navigation.ChartTopItems}"
                             SelectedItem="{Binding Navigation.SelectedNode, Mode=TwoWay}"
                             Style="{StaticResource PieLegendListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="10"
                                             Height="10"
                                             Margin="0,0,12,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding ColorIndex, Converter={StaticResource ChartPaletteBrushConverter}}"
                                             Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                             StrokeThickness="0.5" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Size}" />
                                    <TextBlock Grid.Column="3"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="#FF66A6FF"
                                               Text="{Binding PercentOfRoot}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="1"
                       Margin="0,10,0,0">
                <TextBlock Margin="4,0,0,8"
                           DockPanel.Dock="Top"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{DynamicResource Stats_TopLargeFiles}" />
                <Border Padding="0"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <DataGrid AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              ItemsSource="{Binding Scan.LargeFiles}"
                              RowHeight="30"
                              SelectedItem="{Binding Navigation.SelectedLargeFile, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="48"
                                                Binding="{Binding Rank}"
                                                Header="#" />
                            <DataGridTextColumn Width="2*"
                                                Binding="{Binding Name}"
                                                Header="{DynamicResource Grid_Name}" />
                            <DataGridTextColumn Width="110"
                                                Binding="{Binding Size}"
                                                Header="{DynamicResource Grid_Size}" />
                            <DataGridTextColumn Width="72"
                                                Binding="{Binding PercentOfRoot}"
                                                Header="{DynamicResource Grid_Percent}" />
                            <DataGridTextColumn Width="3*"
                                                Binding="{Binding FullPath}"
                                                Header="{DynamicResource Grid_Path}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
