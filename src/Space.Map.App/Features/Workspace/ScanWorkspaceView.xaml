<UserControl x:Class="Space.Map.App.Views.ScanWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Space.Map.App.Controls"
             xmlns:views="clr-namespace:Space.Map.App.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:TreemapCanvas Grid.Row="0"
                                IsScanning="{Binding Scan.IsScanning}"
                                NodeActivatedCommand="{Binding Navigation.ActivateTreemapNodeCommand}"
                                Root="{Binding Navigation.CurrentTreemapNode}"
                                SelectedNode="{Binding Navigation.SelectedTreemapNode, Mode=TwoWay}"
                                Visibility="{Binding IsTreemapView, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <DataGrid Grid.Row="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding Navigation.LevelItems}"
                  RowHeight="34"
                  SelectedItem="{Binding Navigation.SelectedNode, Mode=TwoWay}"
                  Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="2*"
                                    Binding="{Binding Name}"
                                    Header="{DynamicResource Grid_Name}" />
                <DataGridTextColumn Width="82"
                                    Binding="{Binding Type}"
                                    Header="{DynamicResource Grid_Type}" />
                <DataGridTextColumn Width="110"
                                    Binding="{Binding Size}"
                                    Header="{DynamicResource Grid_Size}" />
                <DataGridTextColumn Width="82"
                                    Binding="{Binding PercentOfRoot}"
                                    Header="{DynamicResource Grid_Percent}" />
                <DataGridTextColumn Width="82"
                                    Binding="{Binding FileCount}"
                                    Header="{DynamicResource Grid_Files}" />
                <DataGridTextColumn Width="82"
                                    Binding="{Binding DirectoryCount}"
                                    Header="{DynamicResource Grid_Directories}" />
                <DataGridTextColumn Width="3*"
                                    Binding="{Binding FullPath}"
                                    Header="{DynamicResource Grid_Path}" />
            </DataGrid.Columns>
        </DataGrid>

        <views:StatisticsView Grid.Row="0"
                              Visibility="{Binding IsStatisticsView, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <views:ScanIssuesPanel Grid.Row="1"
                               Margin="0,8,0,0" />
    </Grid>
</UserControl>
